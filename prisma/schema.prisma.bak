// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Note: SQLite doesn't support enums, so we use strings with validation in the application layer
// Valid values for bodyPart: "CHEST", "ARMS", "SHOULDERS", "BACK", "LEGS", "ABS"
// Valid values for privacy: "FRIENDS", "PRIVATE"
// Valid values for unitPref: "KG", "LBS"
// Valid values for goalType: "BODY_WEIGHT", "WEEKLY_VOLUME", "EXERCISE_WEIGHT"
// Valid values for prType: "WEIGHT", "VOLUME"n// Valid values for notificationType: "LIKE", "COMMENT", "FOLLOW", "NEW_POST", "GOAL_ACHIEVED"

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // MUST be hashed before storage (bcrypt recommended)
  displayName   String
  avatarUrl     String?
  bodyWeightKg  Float?
  heightCm      Float?    // Height in cm
  bio           String?   // User bio/description
  unitPref      String    @default("KG") // User's preferred unit system (KG or LBS)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  workouts      Workout[]
  likes         Like[]
  comments      Comment[]
  following     Follow[]  @relation("UserFollowing")
  followers     Follow[]  @relation("UserFollowers")
  bodyCompositions BodyComposition[]
  goals         Goal[]
  workoutTemplates WorkoutTemplate[]
  personalRecords PersonalRecord[]

  @@map("users")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followeeId  String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followee    User     @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
  @@map("follows")
}

model Exercise {
  id        String   @id @default(cuid())
  name      String
  bodyPart  String   // Body part targeted by this exercise (CHEST, ARMS, SHOULDERS, BACK, LEGS, ABS)
  createdAt DateTime @default(now())

  sets      Set[]
  goals     Goal[]
  templateExercises TemplateExercise[]
  personalRecords PersonalRecord[]

  @@map("exercises")
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // The date of the workout
  note      String?
  privacy   String   @default("FRIENDS") // Workout visibility setting (FRIENDS or PRIVATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets      Set[]
  likes     Like[]
  comments  Comment[]

  @@index([userId])
  @@index([date])
  @@index([createdAt])
  @@map("workouts")
}

model Set {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  weightKg   Float    // Always stored in kg
  reps       Int
  rpe        Float?   // RPE scale: 5.0-10.0 (optional)
  note       String?
  prType     String?  // Type of personal record achieved (WEIGHT or VOLUME)
  createdAt  DateTime @default(now())

  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@index([exerciseId])
  @@index([exerciseId, createdAt])
  @@map("sets")
}

model Like {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@index([workoutId])
  @@index([userId])
  @@map("likes")
}

model BodyComposition {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  bodyWeightKg    Float    // Weight in kg
  bodyFatPercent  Float?   // Optional body fat percentage
  note            String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("body_compositions")
}

model Comment {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@index([userId])
  @@index([createdAt])
  @@map("comments")
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  type        String   // Type of goal being tracked (BODY_WEIGHT, WEEKLY_VOLUME, EXERCISE_WEIGHT)
  targetValue Float    // Target value (kg for weight, kg-reps for volume)
  deadline    DateTime? // Optional deadline
  exerciseId  String?  // For exerciseWeight goals
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise    Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@index([type])
  @@map("goals")
}

model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  type       String   // Type of PR: WEIGHT or VOLUME
  value      Float    // PR value (kg for weight, kg*reps for volume)
  setId      String   // Reference to the set where PR was achieved
  achievedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@index([type])
  @@index([achievedAt])
  @@map("personal_records")
}

model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String   // Template name
  description String?  // Optional description
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   TemplateExercise[]

  @@index([userId])
  @@map("workout_templates")
}

model TemplateExercise {
  id         String   @id @default(cuid())
  templateId String
  exerciseId String
  order      Int      // Order of exercise in template
  createdAt  DateTime @default(now())

  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([exerciseId])
  @@map("template_exercises")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  actorId   String?
  workoutId String?
  goalId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actorId])
  @@index([workoutId])
  @@index([goalId])
  @@index([createdAt])
  @@index([isRead])
  @@map("notifications")
}

model NotificationSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  enableLikeNotif       Boolean  @default(true)
  enableCommentNotif    Boolean  @default(true)
  enableFollowNotif     Boolean  @default(true)
  enableNewPostNotif    Boolean  @default(true)
  enableGoalAchievedNotif Boolean @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("notification_settings")
}
